                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/input_form_edit_text_padding"
                android:text="@string/highest_frequency_default_value"
                android:maxLength="5"
                android:inputType="number"/>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/highest_frequency_value_freq_dimen_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lfm_input_views_left_margin"
            android:text="@string/mega_hertz_freq_dimen"
            app:layout_constraintBottom_toBottomOf="@+id/highest_frequency_value_input_title_text_view"
