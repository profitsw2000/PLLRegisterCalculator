<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/fragment_root_layout_padding"
    android:paddingVertical="@dimen/fragment_root_layout_top_padding"
    tools:context=".presentation.view.MainFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".35" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".7" />

        <TextView
            android:id="@+id/input_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lfm_section_title"
            android:textSize="@dimen/section_title_text_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/lowest_frequency_value_input_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lower_freq_value_field_text"
            app:layout_constraintBottom_toBottomOf="@+id/lowest_frequency_value_text_input_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lowest_frequency_value_text_input_layout" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lowest_frequency_value_text_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@+id/left_guideline"
            app:layout_constraintTop_toBottomOf="@+id/input_title_text_view">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lowest_frequency_value_text_input_edit_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/input_form_edit_text_padding"
                android:inputType="number"
                android:text="@string/lowest_frequency_default_value"
                android:maxLength="5" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/lowest_frequency_value_freq_dimen_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lfm_input_views_left_margin"
            android:text="@string/mega_hertz_freq_dimen"
            app:layout_constraintBottom_toBottomOf="@+id/lowest_frequency_value_input_title_text_view"
            app:layout_constraintStart_toEndOf="@+id/right_guideline"
            app:layout_constraintTop_toTopOf="@+id/lowest_frequency_value_input_title_text_view" />

        <TextView
            android:id="@+id/highest_frequency_value_input_title_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/highest_freq_value_field_text"
            app:layout_constraintBottom_toBottomOf="@+id/highest_frequency_value_text_input_layout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lowest_frequency_value_text_input_layout" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/highest_frequency_value_text_input_layout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:errorEnabled="true"
            app:layout_constraintEnd_toStartOf="@id/right_guideline"
            app:layout_constraintStart_toEndOf="@+id/left_guideline"
